    },
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4",
    "uuid": "11.1.1",
    "fast-xml-builder": "1.1.7",
    "flat-cache": {
      "flatted": "3.4.2"
    },
    "micromatch": {
      "picomatch": "2.3.2"
    },
    "@hono/node-server": "1.19.14",
    "hono": "4.12.28",
    "find-my-way": "9.7.0"
  }
