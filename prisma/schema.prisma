// Learn more about Prisma schema: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Better Auth core + organization plugin (ADR 0002).
// Shapes are owned by Better Auth — change them through its config in
// src/lib/auth.ts, not by hand. Better Auth uses US spelling
// (organization / organizationId); Kigumi's own models use organisationId.
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions               Session[]
  accounts               Account[]
  members                Member[]
  invitations            Invitation[]
  auditLogs              AuditLog[]
  recommendationRequests RecommendationRequest[]
  recommendationFeedback RecommendationFeedback[]
  recordingSessions      RecordingSession[]

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Better Auth's rate-limit store (rateLimit.storage = "database"), so auth
// limits hold across instances and restarts. Pruned by the housekeeping job.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

model Organization {
  id        String   @id
  name      String
  slug      String   @unique
  logo      String?
  createdAt DateTime @default(now())
  metadata  String?
  planTier  String   @default("free") // PlanTier in src/lib/plans.ts
  // Set when first-run setup is finished or skipped (ADR 0025); null = the
  // owners and managers are still sent to /setup.
  setupResolvedAt DateTime?

  members                Member[]
  invitations            Invitation[]
  studios                Studio[]
  rooms                  Room[]
  auditLogs              AuditLog[]
  equipment              EquipmentItem[]
  attachments            Attachment[]
  micUnits               MicrophoneUnit[]
  aiUsage                AiUsage[]
  recommendationRequests RecommendationRequest[]
  recommendationResults  RecommendationResult[]
  recommendationFeedback RecommendationFeedback[]
  recordingSessions      RecordingSession[]
  layouts                Layout[]
  layoutItems            LayoutItem[]
  sessionTemplates       SessionTemplate[]
  dashboardPreferences   DashboardPreference[]
  inputChannels          InputChannel[]
  sessionShareLinks      SessionShareLink[]
  consoleTemplates       ConsoleTemplate[]
  consoles               Console[]
  recallSheets           RecallSheet[]
  recallChannels         RecallChannel[]
  outboardRecalls        OutboardRecall[]
  usageCounters          UsageCounter[]
  maintenancePlans       MaintenancePlan[]
  maintenanceTasks       MaintenanceTask[]
  maintenanceLogs        MaintenanceLog[]
  patTests               PatTest[]
  warranties             Warranty[]
  notifications          Notification[]

  @@map("organization")
}

model Member {
  id             String   @id
  organizationId String
  userId         String
  role           String // MemberRole in src/types/rbac.ts
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String   @id
  organizationId String
  email          String
  role           String?
  status         String   @default("pending")
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  inviterId      String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ---------------------------------------------------------------------------
// Tenant-owned models (ADR 0003). Every one carries a non-null, indexed
// organisationId and is listed in TENANT_MODELS in src/lib/tenant.ts so that
// tenantDb() scopes every query to the caller's active organisation.
// ---------------------------------------------------------------------------

model Studio {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  address        String?
  timezone       String   @default("Europe/London")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organization @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  rooms        Room[]

  @@index([organisationId])
}

model Room {
  id             String   @id @default(cuid())
  organisationId String
  studioId       String
  name           String
  widthMm        Int
  lengthMm       Int
  heightMm       Int?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation           Organization            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  studio                 Studio                  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  equipment              EquipmentItem[]
  recommendationRequests RecommendationRequest[]
  recordingSessions      RecordingSession[]
  layouts                Layout[]

  @@index([organisationId])
  @@index([studioId])
}

// Audit trail for inventory, session and organisation changes (ADR 0010).
model AuditLog {
  id             String   @id @default(cuid())
  organisationId String
  actorUserId    String?
  action         String // e.g. 'room.create'
  entityType     String
  entityId       String
  summary        String
  metadata       Json?
  createdAt      DateTime @default(now())

  organisation Organization @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([organisationId, entityType, entityId])
}

// Studio-owned gear (Phase 1). category/status are string enums validated in
// src/lib/equipment-types.ts. Cables and accessories use quantity.
model EquipmentItem {
  id                 String    @id @default(cuid())
  organisationId     String
  roomId             String?
  category           String // EquipmentCategory
  make               String
  model              String
  serial             String?
  quantity           Int       @default(1)
  status             String    @default("in_service") // EquipmentStatus
  purchaseDate       DateTime?
  purchasePriceMinor Int? // pence / cents, per item
  supplier           String?
  tags               String[]
  customFields       Json?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organisation     Organization      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  room             Room?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  micUnit          MicrophoneUnit?
  layoutItems      LayoutItem[]
  outboardRecalls  OutboardRecall[]
  maintenancePlans MaintenancePlan[]
  maintenanceTasks MaintenanceTask[]
  maintenanceLogs  MaintenanceLog[]
  patTests         PatTest[]
  warranties       Warranty[]
  usageCounter     UsageCounter?

  @@index([organisationId])
  @@index([organisationId, category])
  @@index([roomId])
}

// Files in Blob Storage (photos, receipts and service documents). The
// entity is referenced polymorphically, so there is no foreign key to it.
model Attachment {
  id             String   @id @default(cuid())
  organisationId String
  entityType     String // 'equipment' | 'recall_sheet' | 'warranty' | 'maintenance_log'
  entityId       String
  blobPath       String
  fileName       String
  mimeType       String
  sizeBytes      Int
  kind           String   @default("photo") // AttachmentKind
  createdAt      DateTime @default(now())

  organisation Organization @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, entityType, entityId])
}

// ---------------------------------------------------------------------------
// Microphone catalogue (Phase 2, ADR 0008). The catalogue is GLOBAL: no
// organisationId and not in TENANT_MODELS. Tenants only read published rows;
// platform admins write through src/lib/mics/admin.ts. Enumerated strings are
// validated in src/lib/mics/types.ts.
// ---------------------------------------------------------------------------

model MicrophoneModel {
  id                 String    @id @default(cuid())
  slug               String    @unique
  manufacturer       String
  model              String
  transducerType     String // MicTransducerType
  polarPatterns      String[] // MicPolarPattern
  freqRangeMinHz     Int?
  freqRangeMaxHz     Int?
  sensitivityMvPa    Float?
  selfNoiseDbA       Float?
  maxSplDb           Float?
  impedanceOhm       Float?
  powering           String // MicPowering
  phantomSafe        Boolean? // false for passive ribbons: phantom can damage them
  pads               Int[] // dB
  filters            String[] // e.g. 'HPF 80 Hz'
  weightG            Float?
  dimensions         String?
  connector          String?
  discontinued       Boolean   @default(false)
  statedApplications String[]
  specSheetUrl       String?
  wikidataId         String?
  // Stated conditions beside scalar specs, e.g. { maxSplDb: '@ 1% THD' }.
  specConditions     Json?
  status             String    @default("draft") // MicStatus
  reviewNotes        String?
  reviewedById       String?
  reviewedAt         DateTime?
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  frequencyResponses MicFrequencyResponse[]
  polarData          MicPolarData[]
  fieldProvenance    MicFieldProvenance[]
  units              MicrophoneUnit[]

  @@index([status])
  @@index([manufacturer])
}

// Where a value came from (ADR 0008). We never keep the source document.
model Provenance {
  id             String    @id @default(cuid())
  sourceUrl      String? // null only for unverified drafts awaiting transcription
  documentTitle  String?
  documentPage   String?
  documentSha256 String?
  retrievedAt    DateTime?
  licenceNotes   String?
  attribution    String? // required display text for CC BY sources
  confidence     String    @default("low") // MicConfidence
  extraction     String // MicExtraction
  verifiedById   String?
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())

  fields MicFieldProvenance[]
  freqs  MicFrequencyResponse[]
  polars MicPolarData[]
}

model MicFieldProvenance {
  id           String @id @default(cuid())
  micModelId   String
  field        String // a MicrophoneModel column name
  provenanceId String

  micModel   MicrophoneModel @relation(fields: [micModelId], references: [id], onDelete: Cascade)
  provenance Provenance      @relation(fields: [provenanceId], references: [id], onDelete: Restrict)

  @@unique([micModelId, field])
  @@index([provenanceId])
}

model MicFrequencyResponse {
  id            String   @id @default(cuid())
  micModelId    String
  pattern       String
  filterSetting String? // e.g. 'HPF 80 Hz'
  points        Json // [hz, db][] normalised to 0 dB at 1 kHz
  method        String // MicCurveMethod
  provenanceId  String?
  createdAt     DateTime @default(now())

  micModel   MicrophoneModel @relation(fields: [micModelId], references: [id], onDelete: Cascade)
  provenance Provenance?     @relation(fields: [provenanceId], references: [id], onDelete: Restrict)

  @@index([micModelId])
}

model MicPolarData {
  id           String   @id @default(cuid())
  micModelId   String
  pattern      String
  frequencyHz  Int
  points       Json // [angleDeg, db relative to 0°][]
  method       String // MicCurveMethod
  mirrored     Boolean  @default(false) // half-plot mirrored by the digitiser
  provenanceId String?
  createdAt    DateTime @default(now())

  micModel   MicrophoneModel @relation(fields: [micModelId], references: [id], onDelete: Cascade)
  provenance Provenance?     @relation(fields: [provenanceId], references: [id], onDelete: Restrict)

  @@index([micModelId])
}

// A studio's physical copy of a catalogue model (tenant-owned). Links the
// inventory item to the global model.
model MicrophoneUnit {
  id               String   @id @default(cuid())
  organisationId   String
  micModelId       String
  equipmentItemId  String   @unique
  serial           String?
  condition        String   @default("good") // MicCondition
  matchedPairGroup String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organisation  Organization    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  micModel      MicrophoneModel @relation(fields: [micModelId], references: [id], onDelete: Restrict)
  equipmentItem EquipmentItem   @relation(fields: [equipmentItemId], references: [id], onDelete: Cascade)
  layoutItems   LayoutItem[]
  channels      InputChannel[]

  @@index([organisationId])
  @@index([organisationId, matchedPairGroup])
  @@index([micModelId])
}

// ---------------------------------------------------------------------------
// AI layer (Phase 3, ADR 0007 and 0013). AiSummary is a GLOBAL cache: its
// inputs are catalogue data only (never tenant data), so one generation
// serves every organisation. AiUsage is tenant-owned and drives the monthly
// budget from PLAN_LIMITS.aiRequestsPerMonth.
// ---------------------------------------------------------------------------

model AiSummary {
  id            String   @id @default(cuid())
  kind          String // AiSummaryKind: 'mic' | 'comparison'
  subjectKey    String // mic slug, or the sorted slugs joined by '+'
  inputHash     String // sha256 of the canonical grounding input
  promptVersion String
  model         String
  content       Json // validated against the prompt's Zod schema
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([kind, inputHash, promptVersion])
  @@index([kind, subjectKey])
}

model AiUsage {
  id             String   @id @default(cuid())
  organisationId String
  month          String // 'YYYY-MM' (UTC)
  requests       Int      @default(0)
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  updatedAt      DateTime @updatedAt

  organisation Organization @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, month])
}

// Platform-wide daily AI counter (ADR 0014): a spend ceiling across all
// organisations, so a bug or a busy day can't run up an unbounded bill.
// Global like AiSummary: no organisationId, not in TENANT_MODELS.
model AiPlatformUsage {
  day          String   @id // 'YYYY-MM-DD' (UTC)
  requests     Int      @default(0)
  // The part of `requests` made by Free organisations, which may use at most
  // FREE_TIER_CAP_SHARE of the cap so paid tenants are never crowded out.
  freeRequests Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  updatedAt    DateTime @updatedAt
}

// Per-organisation AI burst limit: fixed one-minute windows shared by every
// instance (src/lib/ai/rate-limit.ts). Global table keyed by organisation, not
// tenant data; pruned by the housekeeping job.
model AiRateWindow {
  id        String   @id // `${organisationId}:${windowStartMs}`
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Microphone recommendations (Phase 4, ADR 0015). Unlike AiSummary these hold
// tenant data (the studio's locker and requests), so every row carries
// organisationId and sits behind tenantDb(). Nothing here is ever shared
// across organisations or written to the global AI cache.
// ---------------------------------------------------------------------------

model RecommendationRequest {
  id              String   @id @default(cuid())
  organisationId  String
  createdById     String?
  kind            String // 'sources' | 'question'
  roomId          String?
  sessionId       String?
  forDate         String? // YYYY-MM-DD
  input           Json // the normalised request
  rules           Json // RulesOutput the model was asked to rank
  locker          Json // LockerSnapshot the rules saw
  aliases         Json // alias -> real id, so aliased replies can be resolved
  rulesVersion    String
  profilesVersion String
  inputHash       String // sha256 of the model input + aliases (org-scoped cache key)
  createdAt       DateTime @default(now())

  organisation Organization           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy    User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  room         Room?                  @relation(fields: [roomId], references: [id], onDelete: SetNull)
  session      RecordingSession?      @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  results      RecommendationResult[]

  @@index([organisationId, createdAt])
  @@index([organisationId, inputHash])
}

model RecommendationResult {
  id             String   @id @default(cuid())
  organisationId String
  requestId      String
  promptVersion  String
  model          String
  content        Json // the validated model reply, still aliased
  final          Json // the finalised view shown to the user (stable if finalise() changes)
  adjustments    Json? // what finalise() repaired
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  createdAt      DateTime @default(now())

  organisation Organization             @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  request      RecommendationRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  feedback     RecommendationFeedback[]

  @@index([organisationId, createdAt])
  @@index([requestId])
}

model RecommendationFeedback {
  id                  String   @id @default(cuid())
  organisationId      String
  resultId            String
  userId              String?
  sourceKey           String // 's3', or '*' for the whole recommendation
  verdict             String // 'accepted' | 'swapped' | 'rejected'
  swappedToUnitIds    String[]
  swappedToModelSlugs String[] // snapshot, survives the unit being deleted
  swappedToCandidate  Boolean? // was the swap one of the offered candidates?
  rating              Int?
  reasons             String[]
  comment             String? // untrusted text; never sent to a model
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organisation Organization         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  result       RecommendationResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  user         User?                @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([resultId, sourceKey, userId])
  @@index([organisationId, createdAt])
}

// ---------------------------------------------------------------------------
// Layouts and sessions (Phase 5, ADR 0016). RecordingSession is named so to
// avoid Better Auth's Session. Lengths are millimetres, angles degrees, times
// UTC. Items store x, y, z, rotation, pitch and size now so a 3D view can read
// the same rows later.
// ---------------------------------------------------------------------------

model RecordingSession {
  id                String   @id @default(cuid())
  organisationId    String
  roomId            String?
  name              String
  client            String?
  startsAt          DateTime
  endsAt            DateTime
  status            String   @default("planned") // SessionStatus
  channelsAvailable Int?
  phantomMode       String   @default("per_channel") // PhantomMode
  notes             String?
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organisation           Organization            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  room                   Room?                   @relation(fields: [roomId], references: [id], onDelete: SetNull)
  createdBy              User?                   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  layout                 Layout?
  channels               InputChannel[]
  shareLinks             SessionShareLink[]
  recommendationRequests RecommendationRequest[]
  recallSheet            RecallSheet?

  @@index([organisationId, startsAt])
  @@index([roomId])
}

// A session's own layout (sessionId set) or a template (sessionId null,
// isTemplate true). The migration adds a check constraint that keeps the two
// in step. The footprint is a snapshot of the room when the layout was made.
model Layout {
  id             String   @id @default(cuid())
  organisationId String
  sessionId      String?  @unique
  isTemplate     Boolean  @default(false)
  roomId         String?
  name           String
  widthMm        Int
  lengthMm       Int
  heightMm       Int?
  gridMm         Int      @default(500)
  snapMm         Int      @default(50)
  version        Int      @default(1)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation    Organization      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  session         RecordingSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  room            Room?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  items           LayoutItem[]
  sessionTemplate SessionTemplate?

  @@index([organisationId, isTemplate])
}

model LayoutItem {
  id                String  @id @default(cuid())
  organisationId    String
  layoutId          String
  type              String // LayoutItemType
  variant           String?
  label             String?
  xMm               Int
  yMm               Int
  zMm               Int     @default(0)
  rotationDeg       Int     @default(0)
  pitchDeg          Int     @default(0)
  widthMm           Int
  depthMm           Int
  heightMm          Int?
  sortOrder         Int     @default(0)
  locked            Boolean @default(false)
  groupId           String?
  micUnitId         String?
  equipmentItemId   String?
  patternSetting    String?
  showPattern       Boolean @default(false)
  recommendationRef String?
  notes             String?

  organisation  Organization    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  layout        Layout          @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  micUnit       MicrophoneUnit? @relation(fields: [micUnitId], references: [id], onDelete: SetNull)
  equipmentItem EquipmentItem?  @relation(fields: [equipmentItemId], references: [id], onDelete: SetNull)
  channel       InputChannel?

  @@index([layoutId])
  @@index([micUnitId])
  @@index([organisationId])
}

model InputChannel {
  id             String  @id @default(cuid())
  organisationId String
  sessionId      String
  number         Int
  layoutItemId   String? @unique
  kind           String  @default("mic") // ChannelKind
  source         String
  micUnitId      String?
  stand          String?
  preampInput    String?
  phantom        Boolean @default(false)
  padDb          Int?
  dawName        String?
  notes          String?

  organisation   Organization     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  session        RecordingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  layoutItem     LayoutItem?      @relation(fields: [layoutItemId], references: [id], onDelete: SetNull)
  micUnit        MicrophoneUnit?  @relation(fields: [micUnitId], references: [id], onDelete: SetNull)
  recallChannels RecallChannel[]

  @@unique([sessionId, number])
  @@index([organisationId])
  @@index([micUnitId])
}

model SessionShareLink {
  id             String    @id @default(cuid())
  organisationId String
  sessionId      String
  // SHA-256 of the URL token (lookups) and the token sealed with a key outside
  // the database (so members can copy the link again). See src/lib/secret-box.ts.
  tokenHash      String    @unique
  tokenSealed    String?
  createdById    String?
  expiresAt      DateTime?
  revokedAt      DateTime?
  lastViewedAt   DateTime?
  createdAt      DateTime  @default(now())

  organisation Organization     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  session      RecordingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([organisationId])
}

// ---------------------------------------------------------------------------
// Console recall (Phase 6, ADR 0017). A template defines a channel strip as
// JSON; a console is a desk using a template; a recall sheet belongs to one
// session and snapshots the strip so a past sheet never changes when the
// template is edited.
// ---------------------------------------------------------------------------

model ConsoleTemplate {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  description    String?
  strip          Json // DeskLayout (v2, ADR 0023); v1 StripDefinition rows are converted on read
  defaultValues  Json? // DeskDefaults: { strip, master } home values
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organization @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  consoles     Console[]

  @@index([organisationId])
}

model Console {
  id             String   @id @default(cuid())
  organisationId String
  templateId     String
  name           String
  make           String?
  model          String?
  channelCount   Int
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation     Organization      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  template         ConsoleTemplate   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  recallSheets     RecallSheet[]
  sessionTemplates SessionTemplate[]

  @@index([organisationId])
  @@index([templateId])
}

model RecallSheet {
  id             String   @id @default(cuid())
  organisationId String
  sessionId      String   @unique
  consoleId      String?
  consoleName    String
  channelCount   Int
  strip          Json // DeskLayout snapshot (v1 StripDefinition on older sheets)
  stripDefaults  Json? // the template's channel defaults when the sheet was made
  masterValues   Json? // values recorded on the master area
  notes          String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organization     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  session      RecordingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  console      Console?         @relation(fields: [consoleId], references: [id], onDelete: SetNull)
  channels     RecallChannel[]
  outboard     OutboardRecall[]

  @@index([organisationId])
  @@index([consoleId])
}

model RecallChannel {
  id             String  @id @default(cuid())
  organisationId String
  recallSheetId  String
  stripNumber    Int
  inputChannelId String?
  label          String
  micName        String?
  values         Json? // { [controlKey]: string | number | boolean }
  notes          String?

  organisation Organization  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  recallSheet  RecallSheet   @relation(fields: [recallSheetId], references: [id], onDelete: Cascade)
  inputChannel InputChannel? @relation(fields: [inputChannelId], references: [id], onDelete: SetNull)

  @@unique([recallSheetId, stripNumber])
  @@index([organisationId])
}

model OutboardRecall {
  id              String  @id @default(cuid())
  organisationId  String
  recallSheetId   String
  equipmentItemId String?
  name            String
  insertOn        String?
  settings        Json? // [{ label, value }]
  notes           String?
  sortOrder       Int     @default(0)

  organisation  Organization   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  recallSheet   RecallSheet    @relation(fields: [recallSheetId], references: [id], onDelete: Cascade)
  equipmentItem EquipmentItem? @relation(fields: [equipmentItemId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([recallSheetId])
}

// ---------------------------------------------------------------------------
// Maintenance, PAT testing, warranty and reminders (Phase 7, ADR 0018).
// Plans are per item or per category; a task is the next occurrence of a plan
// for one item and is rolled forward when it is completed.
// ---------------------------------------------------------------------------

model UsageCounter {
  id              String   @id @default(cuid())
  organisationId  String
  equipmentItemId String   @unique
  hours           Float
  updatedAt       DateTime @updatedAt

  organisation  Organization  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  equipmentItem EquipmentItem @relation(fields: [equipmentItemId], references: [id], onDelete: Cascade)

  @@index([organisationId])
}

model MaintenancePlan {
  id              String    @id @default(cuid())
  organisationId  String
  equipmentItemId String?
  category        String?
  title           String
  notes           String?
  intervalDays    Int?
  intervalHours   Int?
  leadDays        Int       @default(14)
  active          Boolean   @default(true)
  startsOn        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organisation  Organization      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  equipmentItem EquipmentItem?    @relation(fields: [equipmentItemId], references: [id], onDelete: Cascade)
  tasks         MaintenanceTask[]

  @@index([organisationId])
  @@index([equipmentItemId])
}

model MaintenanceTask {
  id              String    @id @default(cuid())
  organisationId  String
  planId          String
  equipmentItemId String
  dueAt           DateTime?
  dueHours        Float?
  lastDoneAt      DateTime?
  createdAt       DateTime  @default(now())

  organisation  Organization     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  plan          MaintenancePlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  equipmentItem EquipmentItem    @relation(fields: [equipmentItemId], references: [id], onDelete: Cascade)
  logs          MaintenanceLog[]

  @@unique([planId, equipmentItemId])
  @@index([organisationId, dueAt])
  @@index([equipmentItemId])
}

model MaintenanceLog {
  id              String   @id @default(cuid())
  organisationId  String
  equipmentItemId String
  taskId          String?
  title           String
  performedAt     DateTime
  performedById   String?
  notes           String?
  costMinor       Int?
  hoursAtService  Float?
  createdAt       DateTime @default(now())

  organisation  Organization     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  equipmentItem EquipmentItem    @relation(fields: [equipmentItemId], references: [id], onDelete: Cascade)
  task          MaintenanceTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([organisationId, performedAt])
  @@index([equipmentItemId])
}

model PatTest {
  id              String    @id @default(cuid())
  organisationId  String
  equipmentItemId String
  testedAt        DateTime
  testType        String // PatTestType
  result          String // PatResult
  testerName      String?
  reference       String?
  notes           String?
  intervalMonths  Int
  nextDueAt       DateTime?
  createdAt       DateTime  @default(now())

  organisation  Organization  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  equipmentItem EquipmentItem @relation(fields: [equipmentItemId], references: [id], onDelete: Cascade)

  @@index([organisationId, nextDueAt])
  @@index([equipmentItemId, testedAt])
}

model Warranty {
  id              String    @id @default(cuid())
  organisationId  String
  equipmentItemId String
  startsOn        DateTime?
  endsOn          DateTime
  provider        String?
  reference       String?
  terms           String?
  leadDays        Int       @default(30)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organisation  Organization  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  equipmentItem EquipmentItem @relation(fields: [equipmentItemId], references: [id], onDelete: Cascade)

  @@index([organisationId, endsOn])
  @@index([equipmentItemId])
}

// In-app reminders. (userId, dedupeKey) is unique so the daily job can run
// any number of times without repeating a reminder.
model Notification {
  id             String    @id @default(cuid())
  organisationId String
  userId         String
  kind           String // NotificationKind
  title          String
  body           String?
  link           String?
  dedupeKey      String
  readAt         DateTime?
  emailedAt      DateTime?
  createdAt      DateTime  @default(now())

  organisation Organization @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([organisationId, userId, readAt])
}

// A studio's own session template (Pro, ADR 0024): the wizard's sources plus
// an optional template Layout and console.
model SessionTemplate {
  id                String   @id @default(cuid())
  organisationId    String
  name              String
  description       String?
  presetId          String?
  sources           Json // WizardSource[]
  layoutId          String?  @unique
  consoleId         String?
  channelsAvailable Int?
  phantomMode       String   @default("per_channel") // PhantomMode
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organisation Organization @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  layout       Layout?      @relation(fields: [layoutId], references: [id], onDelete: SetNull)
  console      Console?     @relation(fields: [consoleId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([consoleId])
}

// One person's dashboard arrangement in one organisation (ADR 0025).
model DashboardPreference {
  id             String   @id @default(cuid())
  organisationId String
  userId         String
  layout         Json
  updatedAt      DateTime @updatedAt

  organisation Organization @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
}
