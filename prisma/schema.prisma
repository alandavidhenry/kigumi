// Learn more about Prisma schema: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Better Auth core + organization plugin (ADR 0002).
// Shapes are owned by Better Auth — change them through its config in
// src/lib/auth.ts, not by hand. Better Auth uses US spelling
// (organization / organizationId); Kigumi's own models use organisationId.
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions               Session[]
  accounts               Account[]
  members                Member[]
  invitations            Invitation[]
  auditLogs              AuditLog[]
  recommendationRequests RecommendationRequest[]
  recommendationFeedback RecommendationFeedback[]

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id        String   @id
  name      String
  slug      String   @unique
  logo      String?
  createdAt DateTime @default(now())
  metadata  String?
  planTier  String   @default("free") // PlanTier in src/lib/plans.ts

  members                Member[]
  invitations            Invitation[]
  studios                Studio[]
  rooms                  Room[]
  auditLogs              AuditLog[]
  equipment              EquipmentItem[]
  attachments            Attachment[]
  micUnits               MicrophoneUnit[]
  aiUsage                AiUsage[]
  recommendationRequests RecommendationRequest[]
  recommendationResults  RecommendationResult[]
  recommendationFeedback RecommendationFeedback[]

  @@map("organization")
}

model Member {
  id             String   @id
  organizationId String
  userId         String
  role           String // MemberRole in src/types/rbac.ts
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String   @id
  organizationId String
  email          String
  role           String?
  status         String   @default("pending")
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  inviterId      String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ---------------------------------------------------------------------------
// Tenant-owned models (ADR 0003). Every one carries a non-null, indexed
// organisationId and is listed in TENANT_MODELS in src/lib/tenant.ts so that
// tenantDb() scopes every query to the caller's active organisation.
// ---------------------------------------------------------------------------

model Studio {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  address        String?
  timezone       String   @default("Europe/London")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organization @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  rooms        Room[]

  @@index([organisationId])
}

model Room {
  id             String   @id @default(cuid())
  organisationId String
  studioId       String
  name           String
  widthMm        Int
  lengthMm       Int
  heightMm       Int?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation           Organization            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  studio                 Studio                  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  equipment              EquipmentItem[]
  recommendationRequests RecommendationRequest[]

  @@index([organisationId])
  @@index([studioId])
}

// Audit trail for inventory, session and organisation changes (ADR 0010).
model AuditLog {
  id             String   @id @default(cuid())
  organisationId String
  actorUserId    String?
  action         String // e.g. 'room.create'
  entityType     String
  entityId       String
  summary        String
  metadata       Json?
  createdAt      DateTime @default(now())

  organisation Organization @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([organisationId, entityType, entityId])
}

// Studio-owned gear (Phase 1). category/status are string enums validated in
// src/lib/equipment-types.ts. Cables and accessories use quantity.
model EquipmentItem {
  id                 String    @id @default(cuid())
  organisationId     String
  roomId             String?
  category           String // EquipmentCategory
  make               String
  model              String
  serial             String?
  quantity           Int       @default(1)
  status             String    @default("in_service") // EquipmentStatus
  purchaseDate       DateTime?
  purchasePriceMinor Int? // pence / cents, per item
  supplier           String?
  tags               String[]
  customFields       Json?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organisation Organization    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  room         Room?           @relation(fields: [roomId], references: [id], onDelete: SetNull)
  micUnit      MicrophoneUnit?

  @@index([organisationId])
  @@index([organisationId, category])
  @@index([roomId])
}

// Files in Blob Storage (photos now; receipts and manuals in Phase 7). The
// entity is referenced polymorphically, so there is no foreign key to it.
model Attachment {
  id             String   @id @default(cuid())
  organisationId String
  entityType     String // 'equipment'
  entityId       String
  blobPath       String
  fileName       String
  mimeType       String
  sizeBytes      Int
  kind           String   @default("photo") // AttachmentKind
  createdAt      DateTime @default(now())

  organisation Organization @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, entityType, entityId])
}

// ---------------------------------------------------------------------------
// Microphone catalogue (Phase 2, ADR 0008). The catalogue is GLOBAL: no
// organisationId and not in TENANT_MODELS. Tenants only read published rows;
// platform admins write through src/lib/mics/admin.ts. Enumerated strings are
// validated in src/lib/mics/types.ts.
// ---------------------------------------------------------------------------

model MicrophoneModel {
  id                 String    @id @default(cuid())
  slug               String    @unique
  manufacturer       String
  model              String
  transducerType     String // MicTransducerType
  polarPatterns      String[] // MicPolarPattern
  freqRangeMinHz     Int?
  freqRangeMaxHz     Int?
  sensitivityMvPa    Float?
  selfNoiseDbA       Float?
  maxSplDb           Float?
  impedanceOhm       Float?
  powering           String // MicPowering
  phantomSafe        Boolean? // false for passive ribbons: phantom can damage them
  pads               Int[] // dB
  filters            String[] // e.g. 'HPF 80 Hz'
  weightG            Float?
  dimensions         String?
  connector          String?
  discontinued       Boolean   @default(false)
  statedApplications String[]
  specSheetUrl       String?
  wikidataId         String?
  // Stated conditions beside scalar specs, e.g. { maxSplDb: '@ 1% THD' }.
  specConditions     Json?
  status             String    @default("draft") // MicStatus
  reviewNotes        String?
  reviewedById       String?
  reviewedAt         DateTime?
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  frequencyResponses MicFrequencyResponse[]
  polarData          MicPolarData[]
  fieldProvenance    MicFieldProvenance[]
  units              MicrophoneUnit[]

  @@index([status])
  @@index([manufacturer])
}

// Where a value came from (ADR 0008). We never keep the source document.
model Provenance {
  id             String    @id @default(cuid())
  sourceUrl      String? // null only for unverified drafts awaiting transcription
  documentTitle  String?
  documentPage   String?
  documentSha256 String?
  retrievedAt    DateTime?
  licenceNotes   String?
  attribution    String? // required display text for CC BY sources
  confidence     String    @default("low") // MicConfidence
  extraction     String // MicExtraction
  verifiedById   String?
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())

  fields MicFieldProvenance[]
  freqs  MicFrequencyResponse[]
  polars MicPolarData[]
}

model MicFieldProvenance {
  id           String @id @default(cuid())
  micModelId   String
  field        String // a MicrophoneModel column name
  provenanceId String

  micModel   MicrophoneModel @relation(fields: [micModelId], references: [id], onDelete: Cascade)
  provenance Provenance      @relation(fields: [provenanceId], references: [id], onDelete: Restrict)

  @@unique([micModelId, field])
  @@index([provenanceId])
}

model MicFrequencyResponse {
  id            String   @id @default(cuid())
  micModelId    String
  pattern       String
  filterSetting String? // e.g. 'HPF 80 Hz'
  points        Json // [hz, db][] normalised to 0 dB at 1 kHz
  method        String // MicCurveMethod
  provenanceId  String?
  createdAt     DateTime @default(now())

  micModel   MicrophoneModel @relation(fields: [micModelId], references: [id], onDelete: Cascade)
  provenance Provenance?     @relation(fields: [provenanceId], references: [id], onDelete: Restrict)

  @@index([micModelId])
}

model MicPolarData {
  id           String   @id @default(cuid())
  micModelId   String
  pattern      String
  frequencyHz  Int
  points       Json // [angleDeg, db relative to 0°][]
  method       String // MicCurveMethod
  mirrored     Boolean  @default(false) // half-plot mirrored by the digitiser
  provenanceId String?
  createdAt    DateTime @default(now())

  micModel   MicrophoneModel @relation(fields: [micModelId], references: [id], onDelete: Cascade)
  provenance Provenance?     @relation(fields: [provenanceId], references: [id], onDelete: Restrict)

  @@index([micModelId])
}

// A studio's physical copy of a catalogue model (tenant-owned). Links the
// inventory item to the global model.
model MicrophoneUnit {
  id               String   @id @default(cuid())
  organisationId   String
  micModelId       String
  equipmentItemId  String   @unique
  serial           String?
  condition        String   @default("good") // MicCondition
  matchedPairGroup String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organisation  Organization    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  micModel      MicrophoneModel @relation(fields: [micModelId], references: [id], onDelete: Restrict)
  equipmentItem EquipmentItem   @relation(fields: [equipmentItemId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([organisationId, matchedPairGroup])
  @@index([micModelId])
}

// ---------------------------------------------------------------------------
// AI layer (Phase 3, ADR 0007 and 0013). AiSummary is a GLOBAL cache: its
// inputs are catalogue data only (never tenant data), so one generation
// serves every organisation. AiUsage is tenant-owned and drives the monthly
// budget from PLAN_LIMITS.aiRequestsPerMonth.
// ---------------------------------------------------------------------------

model AiSummary {
  id            String   @id @default(cuid())
  kind          String // AiSummaryKind: 'mic' | 'comparison'
  subjectKey    String // mic slug, or the sorted slugs joined by '+'
  inputHash     String // sha256 of the canonical grounding input
  promptVersion String
  model         String
  content       Json // validated against the prompt's Zod schema
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([kind, inputHash, promptVersion])
  @@index([kind, subjectKey])
}

model AiUsage {
  id             String   @id @default(cuid())
  organisationId String
  month          String // 'YYYY-MM' (UTC)
  requests       Int      @default(0)
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  updatedAt      DateTime @updatedAt

  organisation Organization @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, month])
}

// Platform-wide daily AI counter (ADR 0014): a spend ceiling across all
// organisations, so a bug or a busy day can't run up an unbounded bill.
// Global like AiSummary: no organisationId, not in TENANT_MODELS.
model AiPlatformUsage {
  day          String   @id // 'YYYY-MM-DD' (UTC)
  requests     Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Microphone recommendations (Phase 4, ADR 0015). Unlike AiSummary these hold
// tenant data (the studio's locker and requests), so every row carries
// organisationId and sits behind tenantDb(). Nothing here is ever shared
// across organisations or written to the global AI cache.
// ---------------------------------------------------------------------------

model RecommendationRequest {
  id              String   @id @default(cuid())
  organisationId  String
  createdById     String?
  kind            String // 'sources' | 'question'
  roomId          String?
  sessionId       String? // Phase 5; no foreign key until sessions exist
  forDate         String? // YYYY-MM-DD
  input           Json // the normalised request
  rules           Json // RulesOutput the model was asked to rank
  locker          Json // LockerSnapshot the rules saw
  aliases         Json // alias -> real id, so aliased replies can be resolved
  rulesVersion    String
  profilesVersion String
  inputHash       String // sha256 of the model input + aliases (org-scoped cache key)
  createdAt       DateTime @default(now())

  organisation Organization           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy    User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  room         Room?                  @relation(fields: [roomId], references: [id], onDelete: SetNull)
  results      RecommendationResult[]

  @@index([organisationId, createdAt])
  @@index([organisationId, inputHash])
}

model RecommendationResult {
  id             String   @id @default(cuid())
  organisationId String
  requestId      String
  promptVersion  String
  model          String
  content        Json // the validated model reply, still aliased
  final          Json // the finalised view shown to the user (stable if finalise() changes)
  adjustments    Json? // what finalise() repaired
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  createdAt      DateTime @default(now())

  organisation Organization             @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  request      RecommendationRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  feedback     RecommendationFeedback[]

  @@index([organisationId, createdAt])
  @@index([requestId])
}

model RecommendationFeedback {
  id                  String   @id @default(cuid())
  organisationId      String
  resultId            String
  userId              String?
  sourceKey           String // 's3', or '*' for the whole recommendation
  verdict             String // 'accepted' | 'swapped' | 'rejected'
  swappedToUnitIds    String[]
  swappedToModelSlugs String[] // snapshot, survives the unit being deleted
  swappedToCandidate  Boolean? // was the swap one of the offered candidates?
  rating              Int?
  reasons             String[]
  comment             String? // untrusted text; never sent to a model
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organisation Organization         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  result       RecommendationResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  user         User?                @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([resultId, sourceKey, userId])
  @@index([organisationId, createdAt])
}
