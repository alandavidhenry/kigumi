# Copy to .env.local and fill in. Never commit real values.

# Database — local docker-compose Postgres (port 5433 so it can run beside Minato's)
DATABASE_URL=postgresql://kigumi:kigumi@localhost:5433/kigumi

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Azure Blob Storage — Azurite well-known dev account on port 10010 locally
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10010/devstoreaccount1;
AZURE_STORAGE_CONTAINER_NAME=kigumi

# Azure Communication Services email — leave blank locally; emails are logged instead
AZURE_COMMUNICATION_CONNECTION_STRING=
ACS_SENDER_ADDRESS=

# Platform admins run the global mic catalogue (review queue at /admin/mics).
# Comma-separated verified emails; leave blank to have no admins.
PLATFORM_ADMIN_EMAILS=

# Cron endpoints (/api/cron/*) — random secret, also a GitHub Actions secret
CRON_SECRET=

# AI (ADR 0007, 0013, 0014). Without a key, cached AI output still shows and
# generating returns 503.
ANTHROPIC_API_KEY=
AI_MODEL_DEFAULT=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5
# Spend guards. AI_ENABLED=false switches AI off everywhere (cached output still
# shows). AI_DAILY_REQUEST_CAP is a platform-wide ceiling on paid model calls per
# UTC day; the default is 100 outside production and 1000 in production.
AI_ENABLED=true
AI_DAILY_REQUEST_CAP=
# Free local testing: run Ollama (or LM Studio), pull a model, then uncomment.
# Development only; refused when NODE_ENV=production. Local calls cost nothing
# and do not count against the daily cap.
# AI_PROVIDER=local
# AI_LOCAL_BASE_URL=http://localhost:11434/v1
# AI_LOCAL_MODEL=qwen2.5:7b
